# ===========================================================================
# RadIA — Variables d'environnement
# ===========================================================================
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env.local dans git.
# Les secrets des Cloud Functions sont gérés via Firebase Secret Manager.
# ===========================================================================

# ---------------------------------------------------------------------------
# Configuration Firebase (côté client — NEXT_PUBLIC_*)
# Ces valeurs sont visibles dans le bundle JavaScript du navigateur.
# Ce ne sont PAS des secrets — elles sont sécurisées par les Firestore Rules.
# Obtenez ces valeurs dans la console Firebase > Paramètres du projet > Vos applications.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ---------------------------------------------------------------------------
# Mode développement
# Mettre à "true" pour se connecter aux émulateurs Firebase locaux.
# Mettre à "false" (ou supprimer) en production.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_USE_EMULATOR=true

# ---------------------------------------------------------------------------
# Clés API tierces (Cloud Functions uniquement — NE PAS METTRE ICI en prod)
# En développement local, vous pouvez les définir ici pour les émulateurs.
# En production, utilisez EXCLUSIVEMENT Firebase Secret Manager :
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set HUGGINGFACE_API_KEY
#   firebase functions:secrets:set GEMINI_API_KEY
# ---------------------------------------------------------------------------

# Clé API OpenAI pour Whisper (transcription audio)
# Obtenez-la sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clé API Hugging Face pour DrBERT et RadPhi-3
# Obtenez-la sur https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clé API Google AI Studio pour Gemini
# Obtenez-la sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
